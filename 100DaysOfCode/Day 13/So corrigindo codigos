def fizz_buzz(target):
    for number in range(1, target + 1):
        print([number])
        if number % 3 == 0 and number % 5 == 0:
            print("FizzBuzz")
        if number % 3 == 0:
            print("Fizz")
        
        if number % 5 == 0:
            print("Buzz")
            
fizz_buzz(15)